# ldapsearch -x -H ldap://dc01.corp.local -b DC=corp,DC=local '(objectClass=user)' \
#   sAMAccountName userAccountControl servicePrincipalName \
#   msDS-SupportedEncryptionTypes adminCount pwdLastSet
dn: DC=corp,DC=local
objectClass: domain
name: corp

dn: CN=svc-backup,OU=Service Accounts,DC=corp,DC=local
sAMAccountName: svc-backup
